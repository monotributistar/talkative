# ── General ──────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth (existing global auth) ──────────────────
AUTH_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
AUTH_DISABLED=true
PERSISTENCE_DRIVER=fs

# ── Database (Prisma — for core talkative features) ──
DATABASE_URL=postgresql://talkative:talkative@localhost:5432/talkative?schema=public

# ── LLM (Gemini free tier — OpenAI-compatible endpoint) ──
# Used by: master-orchestrator, community-classifier skill
# Get key: https://aistudio.google.com/app/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# ── Community Module ──────────────────────────────
# Auth: shared code for residents, password for operators
COMMUNITY_CODE=carilo2026
OPERATOR_PASSWORD=seguridad2026
# SQLite database path (relative to backend root)
COMMUNITY_DB_PATH=./data/community.db
# Gemini key specifically for community classifier (can be same as LLM_API_KEY)
GEMINI_API_KEY=
