# ═══════════════════════════════════════════════════════════
#  Talkative — Environment Variables
#  Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=4000

# ── Auth (global) ───────────────────────────────────────────
# JWT secret for the main platform auth (agents, workflows, etc.)
# Must be >= 32 characters. Set AUTH_DISABLED=true for local dev.
AUTH_JWT_SECRET=your-strong-secret-here-at-least-32-chars
# AUTH_DISABLED=true  # Uncomment for local development only

# ── Community Security Module ───────────────────────────────

# Tenant ID for this deployment (one per neighborhood/barrio)
COMMUNITY_TENANT_ID=tenant-default

# Resident access code (shared with vecinos to submit reports)
COMMUNITY_CODE=changeme

# Operator password (for dashboard/admin access)
OPERATOR_PASSWORD=changeme

# Multi-tenant: comma-separated tenant:code pairs (overrides COMMUNITY_CODE)
# COMMUNITY_CODE_MAP=tenant-carilo:carilo2026,tenant-nordelta:nordelta2026

# ── LLM Classification ─────────────────────────────────────
# Gemini API key (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Auto-classify reports on submission (default: true)
# Set to "false" to require manual operator trigger
# AUTO_CLASSIFY=false

# Or use a custom OpenAI-compatible endpoint:
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# ── Frontend (Vite) ────────────────────────────────────────
# Only needed if frontend and backend are on different origins
# VITE_API_BASE=http://localhost:4000
